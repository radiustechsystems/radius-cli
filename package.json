{
  "name": "radius-monorepo",
  "private": true,
  "description": "Radius CLI wallet and SDK",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "test": "pnpm --filter './packages/*' run test",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "check:api": "pnpm --filter radius-sdk run check:api"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
